{
	"name": "frontend",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.67.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"tailwindcss": "^4.3.4"
	},
	"scripts": {
		"dev": "bun run --parallel dev:css dev:js",
		"dev:css": "tailwindcss -i index.css -o public/assets/styles.css --watch=always",
		"dev:js": "esbuild main.tsx --bundle --outdir=public/assets --servedir=public --serve=3000 --watch=forever"
	},
	"imports": {
		"#components/*": "./components/*.tsx",
		"#lib/*": "./lib/*.ts",
		"#hooks/*": "./hooks/*.ts"
	}
}
