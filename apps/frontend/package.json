{
	"name": "frontend",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"tailwindcss": "^4.3.4"
	},
	"scripts": {
		"dev": "bun run --parallel dev:css dev:js",
		"dev:css": "tailwindcss -i index.css -o public/assets/styles.css --watch",
		"dev:js": "esbuild main.tsx --bundle --outdir=public/assets --servedir=public --serve=3000 --watch=forever"
	}
}
